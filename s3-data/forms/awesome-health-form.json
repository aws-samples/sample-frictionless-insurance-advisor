{
  "form_id": "health",
  "product_type": "health",
  "product_name": "Awesome Health",
  "title": "Awesome Health Application",
  "sections": [
    {
      "id": "applicant",
      "title": "Applicant",
      "fields": [
        {
          "path": "applicant.full_name",
          "label": "Full name",
          "type": "text",
          "required": true
        },
        {
          "path": "applicant.date_of_birth",
          "label": "Date of birth",
          "type": "date",
          "required": true
        },
        {
          "path": "applicant.gender",
          "label": "Gender",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "male",
              "label": "Male"
            },
            {
              "value": "female",
              "label": "Female"
            }
          ]
        },
        {
          "path": "applicant.occupation",
          "label": "Occupation",
          "type": "text",
          "required": true
        },
        {
          "path": "applicant.annual_income",
          "label": "Annual income",
          "type": "currency"
        },
        {
          "path": "applicant.email",
          "label": "Email",
          "type": "text"
        },
        {
          "path": "applicant.phone",
          "label": "Phone",
          "type": "text"
        },
        {
          "path": "applicant.address",
          "label": "Address",
          "type": "text"
        }
      ]
    },
    {
      "id": "coverage",
      "title": "Coverage",
      "fields": [
        {
          "path": "coverage.tier",
          "label": "Coverage tier",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "essential",
              "label": "Essential"
            },
            {
              "value": "standard",
              "label": "Standard"
            },
            {
              "value": "premium",
              "label": "Premium"
            }
          ]
        },
        {
          "path": "coverage.annual_limit",
          "label": "Annual benefit limit",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "10000",
              "label": "$10,000"
            },
            {
              "value": "25000",
              "label": "$25,000"
            },
            {
              "value": "50000",
              "label": "$50,000"
            },
            {
              "value": "100000",
              "label": "$100,000"
            },
            {
              "value": "250000",
              "label": "$250,000"
            }
          ]
        },
        {
          "path": "coverage.deductible",
          "label": "Annual deductible",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "0",
              "label": "$0"
            },
            {
              "value": "250",
              "label": "$250"
            },
            {
              "value": "500",
              "label": "$500"
            },
            {
              "value": "1000",
              "label": "$1,000"
            },
            {
              "value": "2500",
              "label": "$2,500"
            }
          ]
        },
        {
          "path": "coverage.network",
          "label": "Hospital network",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "standard",
              "label": "Standard network"
            },
            {
              "value": "extended",
              "label": "Extended network"
            },
            {
              "value": "open_access",
              "label": "Open access"
            }
          ]
        },
        {
          "path": "coverage.reimbursement",
          "label": "Reimbursement model",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "direct_billing",
              "label": "Direct billing"
            },
            {
              "value": "reimbursement",
              "label": "Reimbursement"
            }
          ]
        },
        {
          "path": "coverage.premium_frequency",
          "label": "Premium frequency",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "monthly",
              "label": "Monthly"
            },
            {
              "value": "quarterly",
              "label": "Quarterly"
            },
            {
              "value": "semi_annual",
              "label": "Semi-annual"
            },
            {
              "value": "annual",
              "label": "Annual"
            }
          ]
        }
      ]
    },
    {
      "id": "addons",
      "title": "Optional coverage",
      "fields": [
        {
          "path": "addons.international",
          "label": "International coverage add-on",
          "type": "boolean"
        },
        {
          "path": "addons.chronic",
          "label": "Chronic condition management",
          "type": "boolean"
        },
        {
          "path": "addons.maternity",
          "label": "Maternity add-on",
          "type": "boolean"
        },
        {
          "path": "addons.hospital_cash",
          "label": "Hospital cash benefit",
          "type": "boolean"
        },
        {
          "path": "addons.hospital_cash_daily",
          "label": "Hospital cash per day ($)",
          "type": "number",
          "hint": "100 to 500, if hospital cash is selected"
        }
      ]
    },
    {
      "id": "health",
      "title": "Health",
      "fields": [
        {
          "path": "health.smoker",
          "label": "Smoker",
          "type": "boolean",
          "required": true
        },
        {
          "path": "health.height_cm",
          "label": "Height (cm)",
          "type": "number"
        },
        {
          "path": "health.weight_kg",
          "label": "Weight (kg)",
          "type": "number"
        },
        {
          "path": "health.existing_conditions",
          "label": "Existing conditions",
          "type": "text",
          "hint": "Comma-separated, or 'none'"
        }
      ]
    }
  ]
}
