  "product_name": "Awesome Universal Life",
  "title": "Awesome Universal Life Application",
  "sections": [
    {
      "id": "coverage",
      "title": "Coverage",
      "fields": [
        {
          "path": "coverage.face_amount",
          "label": "Face amount (death benefit)",
          "type": "currency",
          "required": true,
          "hint": "250k / 500k / 1M / 2M / up to 5M"
        },
        {
          "path": "coverage.death_benefit_option",
          "label": "Death benefit option",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "option_a",
              "label": "Option A: level"
            },
            {
              "value": "option_b",
              "label": "Option B: increasing"
            }
          ]
        },
        {
          "path": "coverage.nlg_to_age",
          "label": "Guarantee to age (no-lapse guarantee)",
          "type": "select",
          "required": true,
          "hint": "The age to which the death benefit is guaranteed if the required premium is paid on time.",
          "options": [
            {
              "value": "90",
              "label": "Age 90"
            },
            {
              "value": "95",
              "label": "Age 95"
            },
            {
              "value": "100",
              "label": "Age 100"
            },
            {
              "value": "121",
              "label": "Lifetime (age 121)"
            }
          ]
        }
      ]
    },
