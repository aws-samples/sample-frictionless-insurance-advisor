{
  "form_id": "variable_life",
  "product_type": "variable_life",
  "product_name": "StardustVariable Life",
  "title": "Variable Life Application",
  "sections": [
    {
      "id": "applicant",
      "title": "Applicant",
      "fields": [
        {
          "path": "applicant.full_name",
          "label": "Full name",
          "type": "text",
          "required": true
        },
        {
          "path": "applicant.date_of_birth",
          "label": "Date of birth",
          "type": "date",
          "required": true
        },
        {
          "path": "applicant.gender",
          "label": "Gender",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "male",
              "label": "Male"
            },
            {
              "value": "female",
              "label": "Female"
            }
          ]
        },
        {
          "path": "applicant.occupation",
          "label": "Occupation",
          "type": "text",
          "required": true
        },
        {
          "path": "applicant.annual_income",
          "label": "Annual income",
          "type": "currency",
          "required": true
        },
        {
          "path": "applicant.email",
          "label": "Email",
          "type": "text",
          "required": false
        },
        {
          "path": "applicant.phone",
          "label": "Phone",
          "type": "text",
          "required": false
        },
        {
          "path": "applicant.address",
          "label": "Address",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "id": "coverage",
      "title": "Coverage",
      "fields": [
        {
          "path": "coverage.sum_assured",
          "label": "Death benefit",
          "type": "currency",
          "required": true,
          "hint": "500k / 1M / 2M / 5M / up to 10M"
        },
        {
          "path": "coverage.death_benefit_option",
          "label": "Death benefit option",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "option_a",
              "label": "Option A — level face amount"
            },
            {
              "value": "option_b",
              "label": "Option B — face + sub-account value"
            },
            {
              "value": "option_c",
              "label": "Option C — face + return of premiums"
            }
          ]
        },
        {
          "path": "coverage.premium_frequency",
          "label": "Premium frequency",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "monthly",
              "label": "Monthly"
            },
            {
              "value": "quarterly",
              "label": "Quarterly"
            },
            {
              "value": "semi_annual",
              "label": "Semi-annual"
            },
            {
              "value": "annual",
              "label": "Annual"
            }
          ]
        },
        {
          "path": "coverage.sub_account_allocation",
          "label": "Sub-account allocation",
          "type": "text",
          "required": true,
          "hint": "e.g. 60% equity, 30% fixed income, 10% money market"
        },
        {
          "path": "coverage.premium_level",
          "label": "Premium level",
          "type": "select",
          "required": false,
          "options": [
            {
              "value": "target",
              "label": "Target premium"
            },
            {
              "value": "minimum",
              "label": "Minimum to keep in force"
            },
            {
              "value": "overfund",
              "label": "Overfund to MEC limit"
            }
          ]
        },
        {
          "path": "coverage.risk_acknowledged",
          "label": "Investment risk acknowledged",
          "type": "boolean",
          "required": true,
          "hint": "Sub-account values can fall; prospectus provided"
        },
        {
          "path": "coverage.riders",
          "label": "Optional riders",
          "type": "text",
          "required": false,
          "hint": "e.g. guaranteed minimum death benefit, dollar cost averaging, waiver of premium"
        }
      ]
    },
    {
      "id": "health",
      "title": "Health",
      "fields": [
        {
          "path": "health.smoker",
          "label": "Smoker",
          "type": "boolean",
          "required": true
        },
        {
          "path": "health.height_cm",
          "label": "Height (cm)",
          "type": "number",
          "required": false
        },
        {
          "path": "health.weight_kg",
          "label": "Weight (kg)",
          "type": "number",
          "required": false
        },
        {
          "path": "health.existing_conditions",
          "label": "Existing conditions",
          "type": "text",
          "required": false,
          "hint": "Comma-separated, or 'none'"
        }
      ]
    },
    {
      "id": "beneficiary",
      "title": "Beneficiary",
      "fields": [
        {
          "path": "beneficiary.name",
          "label": "Full name",
          "type": "text",
          "required": true
        },
        {
          "path": "beneficiary.relationship",
          "label": "Relationship",
          "type": "text",
          "required": true
        },
        {
          "path": "beneficiary.percentage",
          "label": "Allocation (%)",
          "type": "number",
          "required": true
        }
      ]
    }
  ]
}
